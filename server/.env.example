# ============================================================================
# SMART CLINIC OS - BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================

# Server Port
PORT=4000

# JWT Authentication Secret
JWT_SECRET=smart_clinic_jwt_secret_key_production_2026

# Database Connection URL (PostgreSQL / MySQL / SQLite)
DATABASE_URL="postgresql://clinic_user:clinic_password@localhost:5432/smart_clinic_db?schema=public"

# ============================================================================
# OPTION 1: Meta WhatsApp Cloud API (Recommended for official WhatsApp Business)
# ============================================================================
# 1. Go to developers.facebook.com -> WhatsApp App -> API Setup
# 2. Copy System User Access Token and Phone Number ID
WHATSAPP_TOKEN=your_meta_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# ============================================================================
# OPTION 2: Twilio WhatsApp API
# ============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# ============================================================================
# OPTION 3: WATI WhatsApp API
# ============================================================================
WATI_API_ENDPOINT=https://live-server-XXXX.wati.io
WATI_TOKEN=your_wati_bearer_token_here

# ============================================================================
# DIRECT LINK FALLBACK (No API Key Required)
# ============================================================================
# When no API keys are provided above, the system automatically generates
# an instant, pre-filled WhatsApp link:
# https://api.whatsapp.com/send?phone=[PHONE]&text=[ENCODED_MESSAGE]
